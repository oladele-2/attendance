  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.54.6",
    "@tailwindcss/postcss": "4.3.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^26.5.0",
    "@types/qrcode": "^1.5.6",
